# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Preserve generic signatures & annotations for Gson reflection
-keepattributes Signature, *Annotation*, EnclosingMethod, InnerClasses

# Keep ElephantPass Data Models so Gson reflection preserves field names
-keep class nibm.iot.elephantpass.data.models.** { *; }
-keepclassmembers class nibm.iot.elephantpass.data.models.** { *; }

# Keep Gson internals
-keep class com.google.gson.** { *; }
-keepclassmembers class * {
    @com.google.gson.annotations.SerializedName <fields>;
}

# Keep osmdroid MapView and Overlay components
-keep class org.osmdroid.** { *; }
-dontwarn org.osmdroid.**
-dontwarn org.slf4j.**
